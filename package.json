{
  "name": "rooklyn-clima",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "node qa/verify.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json --experimental-warm-cdn-cache",
    "deploy:response-store": "wrangler deploy --config wrangler.response-store.jsonc"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^0.1.0-beta.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@vinext/cloudflare": "^1.0.0-beta.8",
    "lucide-react": "^0.468.0",
    "next": "^16.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-server-dom-webpack": "^19.3.0",
    "vinext": "^1.0.0-beta.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.10",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "wrangler": "^4.132.0"
  },
  "type": "module"
}
