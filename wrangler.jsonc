{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rooklyn-clima",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "main": "vinext/server/fetch-handler",

  "workers_dev": true,
  "preview_urls": true,

  "routes": [
    {
      "pattern": "clima.rooklyn.co",
      "custom_domain": true
    }
  ],

  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },

  "images": {
    "binding": "IMAGES"
  },

  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  "cache": {
    "enabled": false
  }
}
